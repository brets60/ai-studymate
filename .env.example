# AI StudyMate Environment Variables

# Database: SQLite for local development (default), or PostgreSQL for production (Supabase / Neon / Railway)
# For SQLite:
DATABASE_URL="file:./dev.db"
# For PostgreSQL / Supabase:
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Next.js & Authentication Secret
JWT_SECRET="studymate-secure-jwt-secret-key-change-in-production-min-32-chars-long"

# Google Gemini API Key for Academic AI integrations (Tutor, Summaries, Quizzes, Flashcards)
# Get a free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Optional: Upload storage directory (relative to project root or absolute)
UPLOAD_DIR="./uploads"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"
