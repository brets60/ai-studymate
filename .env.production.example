# Free Cloud PostgreSQL (from neon.tech or supabase.com)
DATABASE_URL="postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# JWT Secret for Session Authentication (minimum 32 characters)
JWT_SECRET="studymate-production-secure-jwt-secret-key-32-chars-minimum"

# AI Key (Google Gemini API Key)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"
GROQ_API_KEY="YOUR_GROQ_API_KEY"

# Public App URL (Your Vercel URL)
NEXT_PUBLIC_APP_URL="https://ai-studymate.vercel.app"
